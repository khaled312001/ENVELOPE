{
  "name": "envelope",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "boundaries": "node scripts/check-boundaries.mjs",
    "contrast": "node scripts/contrast.mjs",
    "check": "pnpm boundaries && pnpm contrast && pnpm typecheck && pnpm test && pnpm example && pnpm dxf",
    "smoke": "node scripts/smoke.mjs",
    "shots": "node scripts/shoot.mjs",
    "dev": "pnpm build && pnpm --parallel --filter \"./apps/*\" dev",
    "dev:engine": "tsc -b --watch --preserveWatchOutput",
    "start": "node apps/api/dist/main.js",
    "example": "node scripts/verify-worked-example.mjs && node scripts/verify-readiness.mjs",
    "parity": "vitest run apps/web/test/parity.test.tsx",
    "dxf": "node scripts/verify-dxf.mjs",
    "amber": "node scripts/amber.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dxf-parser": "^1.1.2",
    "esbuild": "0.28.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
